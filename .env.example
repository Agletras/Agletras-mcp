# agletras-mcp — environment variables (all OPTIONAL; defaults shown).
#
# Copy to `.env` only if you want to override something. The server reads
# plain environment variables (OpenCode can pass them via the MCP `environment`
# option); it never requires any secrets, keys, or credentials.
# Never commit real .env files.
#
# SERVER_HOME / PATHS -----------------------------------------------------
# Root directory for all agletras state (defaults to the project directory).
#AGLETRAS_HOME=/absolute/path/to/agletras-mcp
#AGLETRAS_DATA_DIR=/absolute/path/to/agletras-mcp/data
#AGLETRAS_DB_PATH=/absolute/path/to/agletras-mcp/data/research.db
#AGLETRAS_REPORTS_DIR=/absolute/path/to/agletras-mcp/reports
#AGLETRAS_CACHE_DIR=/absolute/path/to/agletras-mcp/cache

# FETCHING (fetch_url, extract_pdf URLs, search providers) ----------------
# Seconds before a fetch is abandoned.            default: 20
#AGLETRAS_FETCH_TIMEOUT=20
# Max response bytes before "too_large".          default: 10485760 (10 MiB)
#AGLETRAS_FETCH_MAX_BYTES=10485760
# Max characters of readable text returned.       default: 50000
#AGLETRAS_FETCH_MAX_CHARS=50000
# Hard ceiling for the fetch_url max_chars argument. default: 500000
#AGLETRAS_MAX_CHARS_CAP=500000
# Maximum redirect hops per fetch.                default: 10
#AGLETRAS_MAX_REDIRECTS=10
# Identifying User-Agent sent with every request.
#AGLETRAS_USER_AGENT=agletras-mcp/0.2.0 (local zero-cost research tool)

# PDF EXTRACTION -----------------------------------------------------------
#AGLETRAS_PDF_MAX_BYTES=104857600   # 100 MiB
#AGLETRAS_PDF_MAX_PAGES=200
#AGLETRAS_PDF_MAX_CHARS=200000

# STORAGE LIST/SEARCH LIMITS ----------------------------------------------
#AGLETRAS_DEFAULT_LIST_LIMIT=20
#AGLETRAS_MAX_LIST_LIMIT=200

# SSRF POLICY (fetch_url / extract_pdf URLs / search providers) ------------
# By default, localhost/loopback, private (RFC1918), link-local (incl. cloud
# metadata 169.254.169.254), multicast, reserved, and shared (CGNAT) targets
# are refused, and every redirect destination is re-validated.
#
# WARNING: set to 1 ONLY for trusted local development/testing (for example
# to fetch pages from a server running on 127.0.0.1). Never enable it when
# URLs come from untrusted input.
#AGLETRAS_ALLOW_PRIVATE_HOSTS=0
# Optional allowlist: when set, ONLY these domains may be fetched.
# Comma-separated; suffix match (example.com also matches sub.example.com).
#AGLETRAS_ALLOWED_DOMAINS=

# WEB SEARCH (search_web) ---------------------------------------------------
# Provider adapter: "duckduckgo" (HTML endpoint, no key, covers the open
# web) or "wikipedia" (official MediaWiki API, encyclopedic only).
#AGLETRAS_SEARCH_PROVIDER=duckduckgo
# Optional endpoint override (mainly for tests or self-hosted mirrors).
#AGLETRAS_SEARCH_ENDPOINT=
# Minimum seconds between consecutive searches (politeness pacing for the
# unofficial DuckDuckGo endpoint).        default: 2.0
#AGLETRAS_SEARCH_MIN_INTERVAL=2.0
# Hard ceiling for the search_web max_results argument. default: 10
#AGLETRAS_MAX_SEARCH_RESULTS=10

# PHASE 2 — LOCAL ACCESS ROOTS (collect_sources / collect_local_folder /
# extract_document) ---------------------------------------------------------
# Explicit directories from which local files may be read. Comma- or
# semicolon-separated absolute paths. Paths outside these roots - including
# paths that resolve outside through a symlink or ".." traversal - are
# refused with access_denied. Default when unset: the project directory.
#AGLETRAS_LOCAL_ROOTS=/absolute/path/to/agletras-mcp

# PHASE 2 — COLLECTION PIPELINE ---------------------------------------------
# Parallel workers per collection job.                     default: 4
#AGLETRAS_COLLECT_CONCURRENCY=4
# Max input sources per job (excess inputs reported as a warning). default: 50
#AGLETRAS_COLLECT_MAX_ITEMS=50
# Retries for TRANSIENT failures only (network/timeouts/429/5xx); permanent
# errors (404/403, unsupported, invalid paths) are never retried. default: 2
#AGLETRAS_COLLECT_MAX_RETRIES=2
# Seconds between retry attempts.                            default: 0.5
#AGLETRAS_COLLECT_BACKOFF=0.5
# Max extracted characters per non-PDF, non-web source.   default: 200000
#AGLETRAS_DOC_MAX_CHARS=200000

# PHASE 2 — FOLDER SCANNING -----------------------------------------------
# Max files collected per collect_local_folder call.       default: 200
#AGLETRAS_FOLDER_MAX_FILES=200
# Max subdirectory levels traversed.                         default: 6
#AGLETRAS_FOLDER_MAX_DEPTH=6
# Max size of a single collected file.                     default: 20 MiB
#AGLETRAS_FOLDER_MAX_FILE_BYTES=20971520
# Max cells rendered across all sheets of an .xlsx file    default: 20000
# (rows beyond it are skipped with a warning).
#AGLETRAS_OFFICE_MAX_CELLS=20000

# PHASE 3 — EVIDENCE LIBRARY (start_research_run / save_evidence /
# search_evidence / register_claim / attach_citation / generate_report) -----
# Seconds an already-stored source may be served from the evidence cache
# without refetching. 0 = always refetch on save_evidence.  default: 86400
#AGLETRAS_EVIDENCE_CACHE_TTL=86400
# Soft size cap (characters) for one citable passage; larger paragraphs are
# split at sentence boundaries.                              default: 1200
#AGLETRAS_EVIDENCE_PASSAGE_CHARS=1200
# Passage search engine: "auto" uses SQLite FTS5 when the build supports it
# and falls back to parameterized LIKE search otherwise; "off" always uses
# the LIKE fallback (handy for testing both paths).       default: auto
#AGLETRAS_EVIDENCE_FTS=auto

# PHASE 5 — IMAGE RESEARCH AND VISUAL ANALYSIS (search_images / analyze_image)
# -----------------------------------------------------------------------------
# Image search provider: "wikimedia_commons" (documented, free, no API key).
#AGLETRAS_IMAGE_SEARCH_PROVIDER=wikimedia_commons
# Max bytes downloaded for a single image (0 = use AGLETRAS_FETCH_MAX_BYTES). default: 10485760 (10 MiB)
#AGLETRAS_IMAGE_MAX_BYTES=10485760
# Max results returned by search_images (hard cap). default: 10
#AGLETRAS_IMAGE_MAX_RESULTS=10
# Max image dimension for analysis; larger images are still reported but
# visual analysis may be bounded. default: 4096
#AGLETRAS_IMAGE_MAX_DIMENSION=4096

# Vision model (analyze_image). Visual analysis is OPT-IN: it only runs when
# AGLETRAS_VISION_MODEL_ENDPOINT is explicitly set by the operator. The
# OpenCode-selected model is never assumed callable from the MCP server.
# Provider name (informational; "none" disables vision). default: none
#AGLETRAS_VISION_PROVIDER=none
# Vision model id. default: nemotron-3.5-super-vl-free
#AGLETRAS_VISION_MODEL=nemotron-3.5-super-vl-free
# Vision model endpoint. When set (and the provider supports image inputs via a
# documented, authenticated interface), analyze_image calls it with base64-encoded
# image bytes. Leave empty to disable visual analysis; image discovery still
# works and the limitation is reported accurately. NEVER put a real secret here.
#AGLETRAS_VISION_MODEL_ENDPOINT=
# Environment variable name holding the vision API key (never committed). default: AGLETRAS_VISION_API_KEY
#AGLETRAS_VISION_API_KEY_ENV=AGLETRAS_VISION_API_KEY

# PHASE 6 — CLAIM VERIFICATION AND SYNTHESIS REPORTS (extract_claims /
# verify_claims / analyze_conflicts / generate_markdown_report / get_report) --
# Model-based verification is OPT-IN: deterministic checks over the stored
# passages always run; a verification model is only called when this endpoint
# is explicitly set (and method="auto"). Responses must cite stored passage
# ids or the deterministic result is recorded with method
# "model_fallback_deterministic". A model verdict never overrides a
# citation-based contradiction. The OpenCode-selected model is never assumed
# callable from the MCP server. Leave empty to disable model verification.
#AGLETRAS_VERIFICATION_MODEL_ENDPOINT=
# Verification model id (informational).                 default: unspecified
#AGLETRAS_VERIFICATION_MODEL=unspecified
# Environment variable name holding the verification API key (never committed).
#AGLETRAS_VERIFICATION_API_KEY_ENV=AGLETRAS_VERIFICATION_API_KEY
# Max claims evaluated per verify_claims call / candidates bounded in
# extract_claims.                                       default: 50
#AGLETRAS_VERIFICATION_MAX_CLAIMS=50
# Max passage candidates compared per claim.            default: 8
#AGLETRAS_VERIFICATION_MAX_CANDIDATES=8
# Phase 6 report size warning threshold: findings beyond it produce a warning;
# the report is never truncated.                        default: 60
#AGLETRAS_REPORT_MAX_FINDINGS=60

# PHASE 7 — CLI, CONFIGURATION FILE, AND THE RESEARCH PIPELINE -----------------
# TOML configuration file for `agletras` (and the MCP server). Precedence:
# CLI flags > environment > this file > built-in defaults. The default file is
# $AGLETRAS_CONFIG, or $AGLETRAS_HOME/agletras.toml when it exists.
#AGLETRAS_CONFIG=
#AGLETRAS_LOGS_DIR=            # default: $AGLETRAS_HOME/logs
#AGLETRAS_LOG_FORMAT=human     # human | json (progress lines on stderr)
#AGLETRAS_LOG_FILE=            # append structured JSONL progress to this file
#AGLETRAS_RESEARCH_DEPTH=standard        # quick | standard | thorough
#AGLETRAS_RESEARCH_MAX_SOURCES=0         # 0 = preset default
#AGLETRAS_RESEARCH_MAX_CLAIMS=0          # 0 = preset default
#AGLETRAS_RESEARCH_RESULTS_PER_SEARCH=0  # 0 = preset default
#AGLETRAS_RESEARCH_SEARCHES_PER_SUBQUESTION=0  # 0 = preset default
#AGLETRAS_RESEARCH_FOLLOWUP_ROUNDS=-1     # -1 = preset, 0 = none, N = at most N
#AGLETRAS_RESEARCH_VERIFICATION_METHOD=auto  # auto | deterministic
#AGLETRAS_RESEARCH_INCLUDE_IMAGES=0
#AGLETRAS_RESEARCH_IMAGE_RESULTS=3
#AGLETRAS_RESEARCH_RESUME_MAX_AGE_DAYS=30  # refuse to resume runs older than this
#AGLETRAS_RESEARCH_REUSE_MAX_AGE_DAYS=7    # max age of a stored copy reused across runs (Phase 8)
#
# Depth presets (quick / standard / thorough): max_sources 4/8/16, max_claims
# 10/25/50, searches per subquestion 1/2/3, follow-up rounds 0/1/2, results
# per search 4/5/6. Explicit research_* settings override the preset; 0 keeps
# the preset value.
